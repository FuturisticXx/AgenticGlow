// The product version, set here and nowhere else. Debug and Release both
// include this file, so every build (Xcode, script/build_and_run.sh, a local
// verification build) reports the current version instead of a placeholder
// the updater would read as older than the shipped release.
// Scripts/build-release.sh refuses a VERSION that disagrees with this value.
// CURRENT_PROJECT_VERSION 8 is the build number 0.8.1 ships with.
MARKETING_VERSION = 0.8.1
CURRENT_PROJECT_VERSION = 8
